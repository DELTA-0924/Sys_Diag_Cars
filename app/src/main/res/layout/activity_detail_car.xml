<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_color_gradient"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/loading5"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@+id/BaseInfo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/BaseInfo"
                app:layout_constraintTop_toBottomOf="@+id/constraintLayout2"
                />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDelete"
                    style="@android:style/Widget.Button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/delete_icon"
                    app:layout_constraintBottom_toBottomOf="@+id/btnBackDetail"
                    app:layout_constraintEnd_toEndOf="parent" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnBackDetail"
                    style="@android:style/Widget.Button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/left_arrow"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/ivCarDetail"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:layout_marginTop="70dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0"
                    tools:srcCompat="@tools:sample/backgrounds/scenic" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/BaseInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"
                android:paddingStart="20dp"
                app:layout_constraintTop_toBottomOf="@+id/constraintLayout2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:id="@+id/tvMarkCar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="10dp"
                    android:text="Марка автомобиля"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMarkCarRes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Toyota Celica"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/tvYearRelease"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="Год Выпуска"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvYearReleaseRes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="2006"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/tvIssueBroken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="Причина Поломки"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvIssueBrokenRes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:text="Аккп"
                    android:textColor="@color/white" />
                <TextView
                    android:id="@+id/tvKmToFailure"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="Пробег до возможной неиспраности"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvKmToFailureRes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:text="км"
                    android:textColor="@color/white" />

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/BaseInfo">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnGetSensors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_login2"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="Получить данные с OBDII"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:iconGravity="top"
                    app:iconPadding="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="invisible" />

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <View
                        android:id="@+id/view4"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:background="@drawable/bg_btn_login"
                        android:visibility="gone"
                        tools:visibility="visible"

                        />

                    <TableLayout
                        android:id="@+id/TbSensors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <!-- Заголовок -->
                        <TableRow tools:visibility="visible">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="#E0E0E0"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:padding="8dp"
                                android:text="@string/sensor_table_header_name"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="#E0E0E0"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:padding="8dp"
                                android:text="@string/sensor_table_header_value"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </TableRow>


                        <TableRow>
                            <TextView
                                style="@style/SensorCell"
                                android:text="@string/sensor_coolant_temp" />

                            <TextView
                                android:id="@+id/sensor1"
                                style="@style/ValueCell"
                                android:text="-- °C" />
                        </TableRow>

                        <TableRow>
                            <TextView
                                style="@style/SensorCell"
                                android:text="@string/sensor_rpm" />

                            <TextView
                                android:id="@+id/sensor2"
                                style="@style/ValueCell"
                                android:text="-- об/мин" />
                        </TableRow>

                        <TableRow>
                            <TextView
                                style="@style/SensorCell"
                                android:text="@string/sensor_fuel_rate" />

                            <TextView
                                android:id="@+id/sensor3"
                                style="@style/ValueCell"
                                android:text="-- л/ч" />
                        </TableRow>

                        <TableRow>
                            <TextView
                                style="@style/SensorCell"
                                android:text="@string/sensor_voltage" />

                            <TextView
                                android:id="@+id/sensor4"
                                style="@style/ValueCell"
                                android:text="-- В" />
                        </TableRow>

                        <TableRow>
                            <TextView
                                style="@style/SensorCell"
                                android:text="@string/sensor_maf" />

                            <TextView
                                android:id="@+id/sensor5"
                                style="@style/ValueCell"
                                android:text="-- г/с" />
                        </TableRow>

                        <TableRow>
                            <TextView
                                style="@style/SensorCell"
                                android:text="@string/sensor_iat" />

                            <TextView
                                android:id="@+id/sensor6"
                                style="@style/ValueCell"
                                android:text="-- °C" />
                        </TableRow>

                        <TableRow>
                            <TextView
                                style="@style/SensorCell"
                                android:text="@string/sensor_tps" />

                            <TextView
                                android:id="@+id/sensor7"
                                style="@style/ValueCell"
                                android:text="-- %" />
                        </TableRow>

                        <TableRow>
                            <TextView
                                style="@style/SensorCell"
                                android:text="@string/sensor_speed" />

                            <TextView
                                android:id="@+id/sensor8"
                                style="@style/ValueCell"
                                android:text="-- км/ч" />
                        </TableRow>

                        <TableRow>
                            <TextView
                                style="@style/SensorCell"
                                android:text="@string/sensor_fuel_trim" />

                            <TextView
                                android:id="@+id/sensor9"
                                style="@style/ValueCell"
                                android:text="-- %" />
                        </TableRow>

                        <TableRow>
                            <TextView
                                style="@style/SensorCell"
                                android:text="@string/sensor_ignition_advance" />

                            <TextView
                                android:id="@+id/sensor10"
                                style="@style/ValueCell"
                                android:text="-- °" />
                        </TableRow>


                    </TableLayout>


                    <View
                        android:id="@+id/view3"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:background="@drawable/bg_btn_login"
                        android:visibility="gone"
                        tools:visibility="visible"/>

                    <TableLayout
                        android:id="@+id/TbErrorCodes"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:layout_marginEnd="10dp"
                                android:text="Код Ошибки"
                                android:textColor="@color/white"
                                android:textSize="20sp" />

                            <TextView
                                android:text="413454"
                                android:textColor="@color/white"
                                android:textSize="20sp" />
                        </TableRow>


                    </TableLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnSendSensors"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_btn_login"
                        android:textColor = "@color/white"
                        android:text="Получить прогноз" />

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>