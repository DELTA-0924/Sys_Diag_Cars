<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_color_gradient"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout2"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnBackDetail"
                    style="@android:style/Widget.Button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/left_arrow"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/ivCarDetail"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:layout_marginTop="70dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0"
                    tools:srcCompat="@tools:sample/backgrounds/scenic" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/BaseInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"
                android:paddingStart="20dp"
                app:layout_constraintTop_toBottomOf="@+id/constraintLayout2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:id="@+id/tvMarkCar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="10dp"
                    android:text="Марка автомобиля"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMarkCarRes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Toyota Celica"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/tvYearRelease"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="Год Выпуска"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvYearReleaseRes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="2006"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/tvIssueBroken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="Причина Поломки"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvIssueBrokenRes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:text="Аккп"
                    android:textColor="@color/white" />

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/BaseInfo">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnGetSensors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_login2"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="Получить данные с OBDII"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:iconGravity="top"
                    app:iconPadding="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="invisible" />

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <View
                        android:id="@+id/view4"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:background="@drawable/bg_btn_login"
                        android:visibility="gone"
                        tools:visibility="visible"

                        />

                    <TableLayout
                        xmlns:android="http://schemas.android.com/apk/res/android"
                        android:id="@+id/TbSensors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:visibility="gone">

                        <!-- Заголовок -->
                        <TableRow>
                            <TextView
                                android:text="Название датчика"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:padding="8dp"
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:layout_height="wrap_content"
                                android:background="#E0E0E0"/>

                            <TextView
                                android:text="Значение"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:padding="8dp"
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:layout_height="wrap_content"
                                android:background="#E0E0E0"/>
                        </TableRow>

                        <!-- Датчики -->
                        <TableRow>
                            <TextView android:text="Температура масла" style="@style/SensorCell"/>
                            <TextView android:text="-- °C" style="@style/ValueCell"/>
                        </TableRow>

                        <TableRow>
                            <TextView android:text="Температура охлаждающей жидкости" style="@style/SensorCell"/>
                            <TextView android:text="-- °C" style="@style/ValueCell"/>
                        </TableRow>

                        <TableRow>
                            <TextView android:text="Обороты двигателя (RPM)" style="@style/SensorCell"/>
                            <TextView android:text="-- об/мин" style="@style/ValueCell"/>
                        </TableRow>

                        <TableRow>
                            <TextView android:text="Расход топлива" style="@style/SensorCell"/>
                            <TextView android:text="-- л/ч" style="@style/ValueCell"/>
                        </TableRow>

                        <TableRow>
                            <TextView android:text="Напряжение генератора" style="@style/SensorCell"/>
                            <TextView android:text="-- В" style="@style/ValueCell"/>
                        </TableRow>

                        <TableRow>
                            <TextView android:text="Расход воздуха (MAF)" style="@style/SensorCell"/>
                            <TextView android:text="-- г/с" style="@style/ValueCell"/>
                        </TableRow>

                        <TableRow>
                            <TextView android:text="Температура впускного воздуха (IAT)" style="@style/SensorCell"/>
                            <TextView android:text="-- °C" style="@style/ValueCell"/>
                        </TableRow>

                        <TableRow>
                            <TextView android:text="Давление во впускном коллекторе (MAP)" style="@style/SensorCell"/>
                            <TextView android:text="-- кПа" style="@style/ValueCell"/>
                        </TableRow>

                        <TableRow>
                            <TextView android:text="Угол открытия дросселя (TPS)" style="@style/SensorCell"/>
                            <TextView android:text="-- %" style="@style/ValueCell"/>
                        </TableRow>

                        <TableRow>
                            <TextView android:text="Скорость автомобиля" style="@style/SensorCell"/>
                            <TextView android:text="-- км/ч" style="@style/ValueCell"/>
                        </TableRow>

                    </TableLayout>


                    <View
                        android:id="@+id/view3"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:background="@drawable/bg_btn_login"
                        android:visibility="gone"
                        tools:visibility="visible"/>

                    <TableLayout
                        android:id="@+id/TbErrorCodes"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TextView
                                android:layout_marginEnd="10dp"
                                android:text="Код Ошибки"
                                android:textColor="@color/white"
                                android:textSize="20sp" />

                            <TextView
                                android:text="413454"
                                android:textColor="@color/white"
                                android:textSize="20sp" />
                        </TableRow>


                    </TableLayout>

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>